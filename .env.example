# Plantilla de variables de entorno. Copia este archivo a ".env" (que no se
# versiona, ver .gitignore) y completa los valores reales de tu entorno.

# Clave secreta de Django. Genera una propia para cada entorno, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" solo en desarrollo local. En produccion debe ser "False".
DJANGO_DEBUG=True

# Dominios/IPs permitidos, separados por coma (obligatorio si DJANGO_DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL. Usa un usuario dedicado para la app, nunca "root"
# (ver setup_mysql_usuario.sql para crearlo con permisos minimos).
DB_NAME=desarmaduria
DB_USER=desarmaduria_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
